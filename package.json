{
  "name": "agents-pm-tool",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:cli": "cargo build --release --bin pm-cli --manifest-path src-tauri/Cargo.toml && node scripts/copy-cli.mjs",
    "build:all": "npm run build && npm run build:cli",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.8"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
