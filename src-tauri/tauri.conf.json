{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri-v2-schema/main/tauri.conf.json",
  "productName": "Agents PM Tool",
  "version": "1.1.1",
  "identifier": "com.agentspmtool.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173/config.html",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "template": "windows/installer.nsi",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
